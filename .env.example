# ===== Model =====
ARK_API_KEY=your_ark_api_key
BASE_URL=https://api.deepseek.com/v1
# 通用主力模型
MODEL=deepseek-v4-flash
# 打分/评测用高精度模型
GRADE_MODEL=deepseek-v4-flash
# 快速低成本轻量模型（高速推理）
FAST_MODEL=deepseek-v4-flash

# ===== 本地稠密向量（langchain_huggingface，默认 BAAI/bge-m3）=====
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DENSE_EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
# Hugging Face 国内镜像源加速（解决直连 huggingface.co 加载本地嵌入模型卡死的问题）
HF_ENDPOINT=https://hf-mirror.com

# ===== Rerank (可选，不配则自动降级) =====
# 重排模型名称（高性能通用）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 硅基流动全局接口地址（不带/v1，代码会自动拼接）
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1
# 硅基流动平台申请的API Key
RERANK_API_KEY=your_rerank_api_key

# ===== 检索候选池 & Auto-merging =====
# 精排后返回给 Agent 的片段数
RETRIEVAL_TOP_K=8
# Milvus 叶子层召回候选数：设 RETRIEVAL_CANDIDATE_K 时优先使用（且 >= top_k）
# 未设 K 时：candidate_k = max(top_k * RETRIEVAL_CANDIDATE_MULTIPLIER, top_k)
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_CANDIDATE_MULTIPLIER=3
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
# 精排后进入 Agent 的最低分：低于该分的片段视为噪音直接丢弃。
# 标定依据：bge-reranker-v2-m3 上跨领域无关片段 <=0.0001，同领域近似片段 0.002~0.012，
# 真正命中 0.24~0.99，故取 0.01。仅在精排真正生效时启用，降级到 RRF 分时不过滤。
RERANK_MIN_SCORE=0.01

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
# 单次 RPC 超时（秒）；连接按请求创建，不长期占用 gRPC channel
MILVUS_TIMEOUT=30

# ===== Database / Cache =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/langchain_app
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Auth =====
JWT_SECRET_KEY=replace-with-strong-random-secret
ADMIN_INVITE_CODE=NovaChat-admin-2026
# 超级管理员邀请码：注册时申请 super_admin 角色必须提供；留空则禁止自助注册超级管理员，
# 只能由已有超级管理员在「超级管理后台 → 用户管理」中创建。
SUPER_ADMIN_INVITE_CODE=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000
# 登录失败锁定阈值与锁定时长（分钟）
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ===== BM25 稀疏统计持久化（默认 data/bm25_state.json，可改路径）=====
# BM25_STATE_PATH=/path/to/bm25_state.json

# ===== Tools（可选）=====
# 是否启用 mcp_config.json 中配置的 MCP 工具（1=启用，0=关闭）
NOVACHAT_MCP_ENABLED=1

# 天气查询工具：使用 uapis.cn 公共接口（免费，无需 API Key）

# 网络搜索工具
# 搜索引擎选择：firecrawl（默认，推荐）/ serper / duckduckgo（免费，结果有限）
WEB_SEARCH_API=firecrawl
# Firecrawl API 密钥（如果使用 firecrawl 搜索引擎，前往 https://firecrawl.dev 获取）
FIRECRAWL_API_KEY=your_firecrawl_api_key
# Serper API 密钥（如果使用 serper 搜索引擎）
SERPER_API_KEY=your_serper_api_key

# 文本分析工具使用 LLM（复用上面的 ARK_API_KEY、BASE_URL、FAST_MODEL 配置）
# 无需额外配置，会自动使用已配置的模型

# ===== 聊天附件（图片/文档）=====
# 是否允许在对话中上传图片。图片需要底层模型支持图像理解（如 GPT-4o / GLM-4.5V / Qwen-VL）。
# 0=只允许文档附件（默认）；1=同时允许图片，图片会以 image_url 多模态内容块发给模型。
# 为 0 时上传图片会返回明确提示，不会把模型侧的原始报错抛给用户。
CHAT_VISION_ENABLED=0

NOVACHAT_MCP_ENABLED=1